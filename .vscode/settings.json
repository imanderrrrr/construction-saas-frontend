{
  // Corrige al guardar lo que ESLint sabe corregir (imports sin usar,
  // comillas, punto y coma). No toca las advertencias que exigen criterio.
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  // Los worktrees son una copia completa del repo dentro del repo: sin estas
  // exclusiones, cada busqueda y cada "Ir a definicion" aparece duplicado, y
  // ESLint analiza el arbol dos veces (ver eslint.config.js).
  "search.exclude": { "**/.claude/worktrees": true, "**/dist": true },
  "eslint.workingDirectories": [{ "mode": "auto" }],

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  "[markdown]": { "files.trimTrailingWhitespace": false }
}
