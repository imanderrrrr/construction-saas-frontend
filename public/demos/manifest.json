{
  "version": 3,
  "recordedAt": "2026-10-27",
  "note": "Screen recordings of the BuildTrack admin panel as it ships, driven by Playwright over a demo dataset (tools/demo-recorder/). One set per language: the panel chrome AND the demo content are recorded in the language of the folder, so the landing page never shows a Spanish panel to an English reader. 1280x800, silent, no narration and no editing beyond the cut. The data is invented — no real client, vendor or person appears; jobsite, client and people names are the same in both sets because proper nouns do not translate. The only dressing is the client-view link, drawn with the production host instead of the recorder's dev server (see tools/demo-recorder/support/stage.ts). Re-record: npx playwright test --config=tools/demo-recorder/recorder.config.ts clips.rec.ts && node tools/demo-recorder/encode.mjs",
  "video": {
    "width": 1280,
    "height": 800,
    "fps": 25
  },
  "playback": {
    "autoplay": "while on screen",
    "loop": true,
    "muted": true,
    "playsInline": true
  },
  "languages": [
    "en",
    "es"
  ],
  "titles": "src/i18n/locales/{es,en}/landing.json — videos.<key>.title",
  "welcome": {
    "key": "bienvenida",
    "sheet": "BT-V00",
    "note": "The narrated welcome film (voice, music, captions), not a screen recording, and the first tab of the player. Made in the infra repo (branch video/bienvenida, videos/bienvenida/); the landing ships web versions of its masters, 1440x900 at about 7 MB per file. Re-encode: tools/welcome-video/encode.sh <lang> <master.mp4> <captions.vtt> <poster.jpg>",
    "video": {
      "width": 1440,
      "height": 900,
      "fps": 60
    },
    "audio": true,
    "playback": {
      "autoplay": "muted with captions while on screen, once — not after the reader paused it or it ended",
      "loop": false,
      "muted": "until the reader asks for sound: «Ver con sonido» / «Watch with sound» starts it over from 0",
      "controls": true,
      "playsInline": true
    },
